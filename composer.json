{
  "name": "linkshare/ran-reporting-api",
  "description": "API wrapper for consuming RAN reporting APIs",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/trafficgate/ran-reporting-api/issues",
    "source": "https://github.com/trafficgate/ran-reporting-api"
  },
  "authors": [
    {
      "name": "Takuto Hayashi",
      "email": "takuto.hayashi@rakuten.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.8",
    "guzzlehttp/psr7": "^1.9.1|^2.5",
    "league/csv": "^9.27",
    "psr/http-message": "^1.1|^2.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.50",
    "phpunit/phpunit": "^11.0",
    "psy/psysh": "^0.12"
  },
  "autoload": {
    "psr-4": {
      "Linkshare\\Api\\RanReporting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Linkshare\\Api\\RanReporting\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.0.x-dev"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
